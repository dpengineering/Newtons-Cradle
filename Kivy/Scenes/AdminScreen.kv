<AdminKey@DPEAButton>:
    background_color: 0, 0, 0, 0
    background_normal: ''
    size_hint: None, None
    size: 80, 80
    color: (0.01, 0.168, .5, 1) if self.state == 'down' else (0.019, 0.337, 1, 1)


<AdminScreen>:
    name: 'admin'
    FloatLayout:
        size_hint: None, None

        AdminKey:
            text: 'Back to Game'
            id: back
            size: 280, 80
            center_x: root.center_x
            center_y: root.center_y + 260
            on_press: root.back_action()

        Label:
            text: '* ' * len(root.entered)
            id: pw
            font_size: 60
            color: 1, 1, 1, 1
            bold: True
            outline_width: self.font_size * 0.1
            outline_color: 0, 0, 0
            center_x: root.center_x
            center_y: root.center_y + 160

        AdminKey:
            text: '1'
            center_x: root.center_x - 100
            center_y: root.center_y + 60
            on_release: root.add_digit(1)

        AdminKey:
            text: '2'
            center_x: root.center_x
            center_y: root.center_y + 60
            on_release: root.add_digit(2)

        AdminKey:
            text: '3'
            center_x: root.center_x + 100
            center_y: root.center_y + 60
            on_release: root.add_digit(3)

        AdminKey:
            text: '4'
            center_x: root.center_x - 100
            center_y: root.center_y - 40
            on_release: root.add_digit(4)

        AdminKey:
            text: '5'
            center_x: root.center_x
            center_y: root.center_y - 40
            on_release: root.add_digit(5)

        AdminKey:
            text: '6'
            center_x: root.center_x + 100
            center_y: root.center_y - 40
            on_release: root.add_digit(6)

        AdminKey:
            text: '7'
            center_x: root.center_x - 100
            center_y: root.center_y - 140
            on_release: root.add_digit(7)

        AdminKey:
            text: '8'
            center_x: root.center_x
            center_y: root.center_y - 140
            on_release: root.add_digit(8)

        AdminKey:
            text: '9'
            center_x: root.center_x + 100
            center_y: root.center_y - 140
            on_release: root.add_digit(9)

        AdminKey:
            text: 'Del'
            center_x: root.center_x - 100
            center_y: root.center_y - 240
            on_release: root.remove_digit()

        AdminKey:
            text: '0'
            center_x: root.center_x
            center_y: root.center_y - 240
            on_release: root.add_digit(0)

        AdminKey:
            text: 'Etr'
            center_x: root.center_x + 100
            center_y: root.center_y - 240
            on_release: root.submit()
