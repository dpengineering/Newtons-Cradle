[Unit]
Description=Newton's Cradle exhibit
Wants=newtons-cradle-update.service
After=newtons-cradle-update.service
StartLimitIntervalSec=0

[Service]
User=@USER@
WorkingDirectory=@EXHIBIT_DIR@
Environment=DISPLAY=:0
ExecStart=@EXHIBIT_DIR@/.venv/bin/python -u main.py
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
